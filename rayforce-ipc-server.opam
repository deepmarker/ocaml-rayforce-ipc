# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A RayforceDB IPC server on the Async scheduler"
description:
  "The server end of RayforceDB's IPC protocol, over the encoder in rayforce-ipc: version handshake, optional credentials, and per-connection in-order handling of async and sync frames, with handler exceptions answered as rayforce error values."
maintainer: ["Vincent Bernardoff <vb@luminar.eu.org>"]
authors: ["Vincent Bernardoff <vb@luminar.eu.org>"]
license: "ISC"
homepage: "https://github.com/deepmarker/ocaml-rayforce-ipc"
doc: "https://github.com/deepmarker/ocaml-rayforce-ipc"
bug-reports: "https://github.com/deepmarker/ocaml-rayforce-ipc/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "4.14.0"}
  "core"
  "core_kernel"
  "async"
  "rayforce-ipc"
  "rayforce-ipc-async" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/deepmarker/ocaml-rayforce-ipc.git"
x-maintenance-intent: ["(latest)"]
